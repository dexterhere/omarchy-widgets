# Maintainer: the Omarchy widget layer contributors
pkgname=omarchy-widgets
pkgver=0.0.0
pkgrel=1
pkgdesc='Provider daemon (owd) and CLI (ow) for Omarchy desktop widgets: encrypted vault, grants, audit'
arch=(x86_64)
url='https://github.com/dexterhere/omarchy-widgets'
license=(MIT)
depends=(gcc-libs)
makedepends=(cargo git)
# makepkg's default LTO flags make the C objects of `ring` unlinkable with rust-lld
# ("undefined symbol: ring_core_..._x25519_sc_mask"); seen building this package on 2026-10-24.
options=(!lto)
# Release builds verify the maintainer's signature on the tag (`?signed`). NOTE: with an empty
# validpgpkeys, makepkg accepts a valid signature from ANY key in the builder's keyring, so
# prepare() refuses to build until a key is pinned. [Maintainer task] put the full 40-hex key
# fingerprint below and sign release tags with `git tag -s`.
# Local testing only: source=("omarchy-widgets::git+file://$PWD#branch=develop") and drop ?signed;
# also skip the guard below by pinning any placeholder fingerprint in your private copy.
source=("omarchy-widgets::git+$url.git?signed#tag=v$pkgver")
validpgpkeys=()
sha256sums=(SKIP) # git sources are verified by the signed tag, not a hash

prepare() {
  (( ${#validpgpkeys[@]} )) || { error 'no validpgpkeys pinned: refusing to build unverified source'; return 1; }
  cd omarchy-widgets
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd omarchy-widgets
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p owd -p ow
}

check() {
  cd omarchy-widgets
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd omarchy-widgets
  install -Dm755 target/release/owd "$pkgdir/usr/bin/owd"
  install -Dm755 target/release/ow "$pkgdir/usr/bin/ow"
  install -Dm644 packaging/owd.service "$pkgdir/usr/lib/systemd/user/owd.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 SECURITY.md "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
  install -Dm644 docs/threat-model.md "$pkgdir/usr/share/doc/$pkgname/threat-model.md"
}
