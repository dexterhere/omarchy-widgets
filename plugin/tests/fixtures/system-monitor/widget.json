  ],
  "capabilities": {
    "network": [],
    "files": [],
    "spawn": []
  },
  "interactiveRegions": [],
  "settings": [],
  "compat": {
    "omarchy": ">=4.0",
    "widgetsKit": "^1"
  },
  "sampleData": {
    "system.cpu": {
      "usage_pct": 34
